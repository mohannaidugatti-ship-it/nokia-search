<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nokia Search</title>
<style>
body {
  font-family: Arial;
  text-align: center;
  padding: 25px 10px;
  background: #f5f5f5;
}
h2 { margin-top: 40px; }
input {
  width: 85%;
  padding: 14px;
  font-size: 18px;
  border: 1px solid #888;
  border-radius: 8px;
}
button {
  padding: 12px 25px;
  margin-top: 15px;
  font-size: 18px;
  border: 0;
  border-radius: 8px;
  background: #2878d0;
  color: white;
}
</style>
</head>
<body>
<h2>Google Search</h2>
<form action="https://www.google.com/search" method="GET">
<input type="text" name="q" placeholder="Search here..." required>
<br>
<button type="submit">SEARCH</button>
</form>
</body>
</html>
